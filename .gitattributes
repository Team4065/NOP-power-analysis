# Normalize line endings to LF in the repo; check out as-is on all platforms.
* text=auto

# Force LF for scripts and source files (prevents CRLF issues on Windows CI)
*.py text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.txt text eol=lf
*.csv text eol=lf

# Treat binary files as binary
*.wpilog binary
*.png binary
*.jpg binary
*.pdf binary
